# Manifold API - Local Development Environment
# Copy this to .env.local and fill in the values

# ─── Core ────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manifold

# Server
PORT=4000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────

# Gatekeeper auth service URL (JWKS + userinfo)
AUTH_BASE_URL=https://localhost:8000

# Webhook signature secrets
AUTH_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

# Require authentication for GraphQL routes
PROTECT_ROUTES=false

# ─── Default Org ───────────────────────────────────────────────────────────

# Default org ID used when billing is not configured (single-tenant mode)
# DEFAULT_ORG_ID=default-org

# ─── Billing (Aether) ───────────────────────────────────────────────────────

# Aether billing service URL and API key
# Omit to disable billing (usage recording degrades gracefully)
# BILLING_BASE_URL=https://aether.omni.dev
# BILLING_SERVICE_API_KEY=

# Provider override: "aether" (default) or "noop" (self-hosted)
# BILLING_PROVIDER=aether

# ─── Authorization (Warden) ─────────────────────────────────────────────────

# Permify PDP API URL for fine-grained authorization
# AUTHZ_API_URL=https://warden.omni.dev
# AUTHZ_ENABLED=true

# Provider override: "permify" (default) or "noop" (self-hosted)
# AUTHZ_PROVIDER=permify

# ─── Feature Flags (Unleash) ────────────────────────────────────────────────

# Unleash instance for feature flags (maintenance mode, etc.)
# FLAGS_API_HOST=https://flags.omni.dev/api
# FLAGS_CLIENT_KEY=

# Namespaces allowed when maintenance mode flag is enabled
MAINTENANCE_ALLOWED_NAMESPACES=omni

# ─── OCI Registry Auth ──────────────────────────────────────────────────────

# Require Basic-auth on the OCI registry (/v2). Optional; default "false"
# leaves the registry unauthenticated (safe ONLY when reachable exclusively
# over a private network, which is how it runs in-cluster today). Set "true"
# ONLY once every pusher (buildkit/kiln) and puller (kubelet imagePullSecret)
# carries REGISTRY_AUTH_TOKEN, otherwise builds and deploys break. Required
# before exposing the registry on any public hostname.
# REGISTRY_REQUIRE_AUTH=false
# REGISTRY_AUTH_TOKEN=

# ─── Blob Storage ───────────────────────────────────────────────────────────

# Storage backend: "fs" (local filesystem) or "s3" (S3-compatible)
# BLOB_STORAGE_BACKEND=fs
# BLOB_STORAGE_DIR=.blobs

# S3 configuration (when BLOB_STORAGE_BACKEND=s3)
# BLOB_S3_BUCKET=manifold-blobs
# BLOB_S3_REGION=us-east-1
# BLOB_S3_ENDPOINT=https://s3.amazonaws.com
# BLOB_S3_PREFIX=blobs/

# ─── Event Streaming (Vortex) ───────────────────────────────────────────────

# Vortex workflow automation service
VORTEX_API_URL=https://localhost:5000
VORTEX_API_KEY=

# ─── Federation ─────────────────────────────────────────────────────────────

# Enable federation proxy for upstream skill registries
FEDERATION_ENABLED=false
FEDERATION_AUTO_APPROVE=true
# Sync interval in ms (default: 6 hours)
FEDERATION_SYNC_INTERVAL_MS=21600000

# ─── Cargo Registry ─────────────────────────────────────────────────────────

# Public URL used in Cargo sparse index config.json
# PUBLIC_URL=https://manifold.omni.dev

# ─── GraphQL ─────────────────────────────────────────────────────────────────

# Max query complexity cost (GraphQL Armor)
# GRAPHQL_MAX_COMPLEXITY_COST=5000
